{
  "name": "atx-revival",
  "version": "1.0.0",
  "description": "Austin Business Web Redesign Engine - Automated AI-powered web redesign pipeline",
  "main": "scripts/orchestrator.js",
  "type": "module",
  "scripts": {
    "start": "node scripts/orchestrator.js",
    "discover": "node scripts/agents/discovery-agent.js",
    "parse": "node scripts/agents/parser-agent.js",
    "redesign": "node scripts/agents/redesign-agent.js",
    "deploy": "node scripts/agents/deploy-agent.js",
    "outreach": "node scripts/agents/outreach-agent.js",
    "test": "node scripts/orchestrator.js --limit 5",
    "scrape:google": "node scripts/google-places-scraper.js",
    "scrape:yelp": "node scripts/yelp-api-scraper.js",
    "scrape:chambers": "node scripts/scrape-chambers.js",
    "scan:websites": "node scripts/scan-websites-local.js",
    "rate:businesses": "node scripts/rate-businesses.js",
    "consolidate": "node scripts/consolidate-all-businesses.js",
    "import:csv": "node scripts/import-businesses-csv.js",
    "compile:all": "npm run scrape:google && npm run scrape:yelp && npm run consolidate",
    "clone:templates": "./scripts/clone-templates.sh"
  },
  "keywords": [
    "web-redesign",
    "ai",
    "automation",
    "austin",
    "local-business"
  ],
  "author": "Domain Labs",
  "license": "MIT",
  "dependencies": {
    "@mendable/firecrawl-js": "^4.5.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "puppeteer": "^21.6.0"
  },
  "devDependencies": {
    "prettier": "^3.1.1"
  }
}
