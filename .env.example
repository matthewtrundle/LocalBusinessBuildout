# ATX Revival Environment Variables
# Copy this file to .env and fill in your API keys

# Google Maps API (for business discovery)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Yelp Fusion API (for business discovery)
YELP_API_KEY=your_yelp_api_key_here

# Anthropic Claude API (for AI redesigns)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SendGrid (for outreach emails)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Vercel (for deployment)
VERCEL_TOKEN=your_vercel_token_here

# Optional: Webhook for lead capture
WEBHOOK_URL=https://hooks.slack.com/your-webhook-url
